{
    "name": "sandermuller/laravel-x402",
    "description": "Laravel adapter for the x402 payment protocol — pay-per-request HTTP APIs with stablecoins.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "x402",
        "http-402",
        "payments",
        "stablecoin",
        "usdc",
        "middleware"
    ],
    "homepage": "https://github.com/sandermuller/laravel-x402",
    "authors": [
        {
            "name": "Sander Muller",
            "email": "sander@hihaho.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.9|^8.0",
        "illuminate/console": "^12.0||^13.0",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "nyholm/psr7": "^1.8",
        "sandermuller/php-x402": "^0.8.0",
        "symfony/psr-http-message-bridge": "^7.0|^8.0"
    },
    "require-dev": {
        "aws/aws-sdk-php": "^3.395.6",
        "dg/bypass-finals": "^1.11",
        "driftingly/rector-laravel": "^2.6.2",
        "larastan/larastan": "^3.12.1",
        "laravel/boost": "^2.9.1||^3.0",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "orchestra/testbench": "^11.2",
        "pestphp/pest": "^5.2.1",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-phpstan": "^5.2.1",
        "pestphp/pest-plugin-rector": "^5.0.4",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "rector/rector": "^2.6.7",
        "sandermuller/boost-skills": "^2.44.0",
        "sandermuller/package-boost-laravel": "^1.1",
        "spaze/phpstan-disallowed-calls": "^4.14",
        "stolt/lean-package-validator": "^6.0.2",
        "symplify/phpstan-rules": "^14.13.1",
        "tomasvotruba/cognitive-complexity": "^1.2",
        "tomasvotruba/type-coverage": "^2.3.6"
    },
    "suggest": {
        "aws/aws-sdk-php": "Required when X402_WALLET_DRIVER=kms and X402_WALLET_KMS_PROVIDER=aws — wires the buyer wallet to AWS KMS so the signing key never touches PHP."
    },
    "autoload": {
        "psr-4": {
            "X402\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "X402\\Laravel\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.5.x-dev"
        },
        "laravel": {
            "providers": [
                "X402\\Laravel\\X402ServiceProvider"
            ],
            "aliases": {
                "X402": "X402\\Laravel\\Facades\\X402"
            }
        }
    },
    "scripts": {
        "post-install-cmd": [
            "SanderMuller\\PackageBoostLaravel\\Scripts\\AutoSync::run"
        ],
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
        "phpstan-simplified": "vendor/bin/phpstan analyse --memory-limit=2G --error-format symplify",
        "phpstan-clear-cache": "vendor/bin/phpstan clear-result-cache",
        "format": "vendor/bin/pint",
        "rector": "vendor/bin/rector process",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "sync-ai": "vendor/bin/boost sync",
        "lean-dist": "vendor/bin/lean-package-validator validate --validate-git-archive",
        "validate-gitattributes": "vendor/bin/lean-package-validator validate",
        "qa": [
            "@rector",
            "@format",
            "@phpstan-simplified",
            "@validate-gitattributes"
        ],
        "post-update-cmd": [
            "SanderMuller\\PackageBoostLaravel\\Scripts\\AutoSync::run"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
